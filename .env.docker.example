# ===========================================
# Quang Huong Computer - Docker Environment Variables
# ===========================================
# Copy this file to .env.docker and fill in your values
# Usage: docker-compose --env-file .env.docker up -d
# ===========================================

# ================================
# PostgreSQL Database
# ================================
POSTGRES_DB=quanghuongdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_PORT=5432

# ================================
# Redis Cache
# ================================
REDIS_PASSWORD=your_secure_redis_password
REDIS_PORT=6379

# ================================
# RabbitMQ Message Queue
# ================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_secure_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ================================
# Adminer (Database UI)
# ================================
ADMINER_PORT=8081

# ================================
# MinIO (Object storage cho ảnh/video sản phẩm - Phase 03)
# ================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=quanghuong-media
MINIO_PUBLIC_BASE_URL=http://localhost:9000
