# ===========================================
# Quang Huong Computer — local `make up` / `make dev` environment (D05 / phase-64 W1-14)
# ===========================================
# `make up` creates .env.docker from this file automatically (with random secrets via
# scripts/gen-secrets.sh) when it is missing — you normally never copy this by hand.
# Usage: docker compose --profile app --env-file .env.docker up -d --wait
# ===========================================

# Local default: plain HTTP, no domain, no cert to request (deploy/Caddyfile: SITE_URL default
# is this same value). Leave as-is unless you are testing a real domain locally.
SITE_URL=http://localhost:8080

COMPOSE_PROJECT_NAME=quanghuong
ASPNETCORE_ENVIRONMENT=Development

# ---- PostgreSQL ----
POSTGRES_DB=quanghuongdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432

# ---- Redis (cache only) ----
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# ---- RabbitMQ (image pinned to 4.3 in docker-compose.yml) ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- JWT ----
JWT_KEY=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING
JWT_EXPIRE_MINUTES=60

# ---- Demo administrator (db seed --profile demo also adds the 9 documented demo accounts — ----
# ---- see docs/deployment-guide.md — this is only the first ADMIN if none exists yet) ----
ADMIN_EMAIL=admin@quanghuong.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ONE_TIME_PASSWORD

# ---- Ports for the app tier + tools profile ----
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
ADMINER_PORT=8081

# Everything else (OAuth, Payment, SMTP, AI) is optional and blank by default locally — see
# .env.prod.example for the full list if you need to test one against this stack.
