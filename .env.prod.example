# ===========================================
# Quang Huong Computer — Production environment (D05 / phase-64 W1-14)
# ===========================================
# Copy to .env.prod on the server, `chmod 600`, NEVER commit it.
# `scripts/gen-secrets.sh` fills every CHANGE_ME_* below with an `openssl rand` value.
# UAT reuses this SAME file/shape (docker-compose.prod.yml) with different values — D05 §2:
# "UAT = same compose file as prod with a different .env" — there is no separate UAT template.
#
# Usage:
#   scripts/gen-secrets.sh
#   make deploy TAG=v1.2.3   # or: make up   for a fresh clone / local demo
# ===========================================

# ---- One address drives everything (D05 §3): Caddy's site address, VITE_API_URL, ----
# ---- Storage:PublicBaseUrl, Cors:AllowedOrigins:0, Frontend:Url, payment return URLs. ----
SITE_URL=https://quanghuongcomputer.vn
ACME_EMAIL=admin@quanghuongcomputer.vn

APP_VERSION=latest
COMPOSE_PROJECT_NAME=quanghuong
ASPNETCORE_ENVIRONMENT=Production

# ---- Registry images (built + pushed by .github/workflows/deploy.yml on a git tag) ----
API_IMAGE=ghcr.io/quanghuongcomputer/api
WEB_IMAGE=ghcr.io/quanghuongcomputer/web
BACKUP_IMAGE=ghcr.io/quanghuongcomputer/backup

# ---- Published ports: docker-compose.prod.yml leaves `ports` untouched for `web` on purpose ----
# ---- (see that file's header) — these two ARE how you get 80/443 instead of the dev 8080/8443. ----
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ---- PostgreSQL ----
POSTGRES_DB=quanghuongdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ---- Redis (cache only — no AOF, no volume; a restart loses the cache, nothing else) ----
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ---- RabbitMQ (image pinned to 4.3 in docker-compose.yml — never override the tag here) ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD

# ---- JWT ----
JWT_KEY=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING_FOR_PRODUCTION_JWT
JWT_EXPIRE_MINUTES=60

# ---- Attendance QR (HR) — secret TOTP chấm công; thiếu thì chấm công QR bị từ chối ----
ATTENDANCE_TOTP_SECRET=CHANGE_ME_ATTENDANCE_TOTP_SECRET

# ---- reCAPTCHA v3 (đăng nhập/đăng ký) — BẬT mặc định; thiếu secret trên Production thì server ----
# ---- TỪ CHỐI mọi đăng nhập bằng mật khẩu. Hoặc điền cả SITE_KEY (web build) + SECRET_KEY, ----
# ---- hoặc đặt RECAPTCHA_ENABLED=false và xoá trắng SECRET_KEY. make check-secrets chặn deploy ----
# ---- khi còn CHANGE_ME. Lưu ý: image web dựng sẵn từ CI không có SITE_KEY — dùng make prod-build. ----
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=CHANGE_ME_RECAPTCHA_SECRET_KEY

# ---- First administrator (D05 §10 — created ONLY when no account holds the Admin role) ----
ADMIN_EMAIL=owner@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ONE_TIME_PASSWORD

# ---- OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Payment (D04 — optional, per provider: blank + Enabled=false is the correct opening-day ----
# ---- state; PaymentConfigGuard fail-closed keeps it out of GET /api/payments/methods until every ----
# ---- required key is real). COD needs none of these and is on by default. ----
PAYMENT_ALLOW_SANDBOX=false
PAYMENT_SEPAY_ENABLED=false
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
PAYMENT_VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://pay.vnpay.vn/vpcpay.html
PAYMENT_MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create

# ---- Email (optional — blank means the app logs instead of sending, never a fake "sent") ----
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Quang Huong Computer
SMTP_FROM_EMAIL=

# ---- AI (optional) ----
GEMINI_API_KEY=

# ---- Backup sidecar (D05 §6 — offsite bucket in Vietnam recommended; everything blank below ----
# ---- means "keep dumps on this server's disk only", a safe and valid default) ----
BACKUP_AGE_PUBLIC_KEY=
# The matching PRIVATE key is never stored on the server or in this file. Keep it offline; pass
# it in only for the monthly drill: `make restore-drill AGE_PRIVATE_KEY=$(cat offsite.age.key)`
BACKUP_S3_REMOTE=
# Absolute path on the HOST to an rclone.conf holding real bucket credentials — never checked
# into git. Leave unset to keep backups local-only.
BACKUP_S3_RCLONE_CONF_HOST=
