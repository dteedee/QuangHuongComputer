# Quang Huong Computer — edge proxy (D05 / phase-64 W1-14)
#
# Replaces the 267-line broken nginx.prod.conf (commented-out HTTPS block, no certbot, wrong
# uploads path) with automatic HTTPS + HTTP/1.1↔2↔3 + WebSocket proxying, no extra config.
#
# ONE variable drives the site address: SITE_URL (same variable also feeds VITE_API_URL,
# Storage:PublicBaseUrl, Cors:AllowedOrigins:0, Frontend:Url and payment return URLs — see
# docker-compose.yml / .env.prod.example). Local default is plain HTTP on :8080 (no domain, no
# cert to request); a real domain here (docker-compose.prod.yml) switches Caddy to automatic
# HTTPS + HTTP->HTTPS redirect + HSTS with zero other changes.
#
# W2-17 (D11): the final `handle` (SPA fallthrough) is now the SEO-shell rule
# (`rewrite * /_shell{uri}` -> api:8080, real 200/301/404 per URL) with a static-`index.html`
# fallback for BOTH failure modes Caddy distinguishes: the api container answering with a
# server error (`handle_response` on the reverse_proxy) and Caddy being unable to reach it at all
# (`handle_errors` at the site level). Neither path uses `lb_try_duration` (D05 mục 12) — a shell
# request must fail FAST to the static fallback, never hang for 30s like /api/* and /hubs/* do.
#
# NOT verified against a real `caddy validate` / running container on this machine (no local
# `caddy` binary, docker compose is off-limits per D12 §8 — same gap the plan already flags:
# "Caddy's handle_response/handle_errors behave differently in practice — unverified on this
# machine; W1-14 validates the file inside the caddy image and W2-G runs it for real once").
{
	email {$ACME_EMAIL:admin@example.com}
}

(security_headers) {
	# CSP: the SAME policy the API sends (backend/BuildingBlocks/Security/ContentSecurityPolicy.cs,
	# minus upgrade-insecure-requests — HSTS covers the real domain and the local http://localhost:8080
	# stack must not be upgraded). ContentSecurityPolicyTests fails if the two strings drift.
	# `defer` makes these REPLACE what the api container already sent on proxied responses (the SEO
	# shell HTML) instead of adding a second, differing CSP header next to it.
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com https://www.gstatic.com https://www.google.com https://www.googletagmanager.com https://connect.facebook.net; frame-src 'self' https://accounts.google.com https://www.google.com https://recaptcha.google.com https://www.youtube.com https://www.youtube-nocookie.com https://maps.google.com https://www.facebook.com; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://www.google.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://graph.facebook.com https://www.facebook.com wss: ws:; style-src 'self' 'unsafe-inline' https://accounts.google.com https://fonts.googleapis.com; img-src 'self' data: blob: https://lh3.googleusercontent.com https://www.google.com https://i.ytimg.com https://api.qrserver.com https://*.google-analytics.com https://www.googletagmanager.com https://www.facebook.com https://platform-lookaside.fbsbx.com https://res.cloudinary.com https://*.cloudinary.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://accounts.google.com https://www.facebook.com https://sandbox.vnpayment.vn https://pay.vnpay.vn https://test-payment.momo.vn https://payment.momo.vn"
	}
}

# Internal listener the SEO shell fetches `index.html` from (`Seo:ShellTemplateUrl` in prod =
# `http://web:8081/index.html` — this IS the `web` container, D11 §"Architecture"). Not exposed
# to the internet; only reachable from other containers on the compose network.
:8081 {
	root * /srv
	file_server
}

{$SITE_URL:http://localhost:8080} {
	encode zstd gzip

	# /api/* and /hubs/* (SignalR) are the only routes allowed to hold a request open while the
	# api container restarts (D05 mục 12) — everything else must fail fast to the static SPA
	# instead of hanging for 30s. lb_try_interval is the poll cadence inside that window.
	handle /api/* {
		reverse_proxy api:8080 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
	# WebSocket upgrade (SignalR) needs no special config: reverse_proxy detects and proxies
	# `Connection: Upgrade` automatically (Caddy docs — "WebSocket support").
	handle /hubs/* {
		reverse_proxy api:8080 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
	# /media/* is the D02 runtime + seed image route; /uploads/* is kept only as a legacy alias.
	handle /media/* {
		reverse_proxy api:8080
	}
	handle /uploads/* {
		reverse_proxy api:8080
	}
	handle /health* {
		reverse_proxy api:8080
	}
	handle /sitemap.xml {
		reverse_proxy api:8080
	}
	handle /robots.txt {
		reverse_proxy api:8080
	}

	# Built asset files (hashed names -> safe to cache forever) still go straight to disk, never
	# through the shell — a JS/CSS/image request rewritten to `/_shell/assets/...` would 404.
	@assets path *.js *.css *.svg *.woff2 *.png *.jpg *.webp *.ico
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# A direct hit on `/_shell*` from OUTSIDE must 404 — otherwise the rewrite below would stack
	# into `/_shell/_shell/...` on a request that already carries the prefix (D11 §"Architecture").
	handle /_shell* {
		respond 404
	}

	# Everything else -> the SEO shell (W2-17 / D11): real title/meta/JSON-LD/status per URL for
	# every request, not just bots. `handle_response` covers the api CONTAINER being up but
	# answering 502/503/504 (e.g. mid-deploy); `handle_errors` below covers Caddy not being able
	# to reach it at all.
	handle {
		rewrite * /_shell{uri}
		reverse_proxy api:8080 {
			@shellUpstreamError status 502 503 504
			handle_response @shellUpstreamError {
				root * /srv
				rewrite * /index.html
				file_server
			}
		}
	}

	handle_errors {
		# Error routes do not inherit the site-level `header`, and this one serves the SPA itself.
		import security_headers
		root * /srv
		rewrite * /index.html
		file_server
	}

	import security_headers

	log {
		output stdout
		format json
	}
}
