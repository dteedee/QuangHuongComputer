<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.2" />
  </ItemGroup>
  <!--
    Test phân quyền (UnitTests/Security) dựng Endpoint/RouteEndpointBuilder giả nên cần
    khung ASP.NET Core. Khai báo tường minh thay vì dựa vào truyền từ các project Services.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    W1-1 / IR W0 #45: test nào cần type trong ApiGateway thì cần project reference này
    (ReviewValidationMiddleware từng dùng nó; đã gỡ khi Catalog hỏi Sales trực tiếp qua
    IPurchaseVerificationQuery). ĐỂ TẮT MẶC ĐỊNH: UnitTests.csproj là assembly dùng chung cho
    mọi track, mà ApiGateway.csproj chưa từng được compile trong đợt này (IR W0 #46) —
    bật lên khi nó còn lỗi sẽ làm hỏng `qh-build.sh be-test` của TẤT CẢ các track.
    Bật bằng: dotnet test ... -p:IncludeApiGatewayTests=true
    Cổng W1-G nên đổi thành mặc định true sau lần build ApiGateway sạch đầu tiên.
  -->
  <ItemGroup Condition="'$(IncludeApiGatewayTests)' == 'true'">
    <ProjectReference Include="../../ApiGateway/ApiGateway.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IncludeApiGatewayTests)' == 'true'">
    <DefineConstants>$(DefineConstants);QH_APIGATEWAY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Services/Accounting/Accounting.csproj" />
    <ProjectReference Include="../../Services/Catalog/Catalog.csproj" />
    <ProjectReference Include="../../Services/Sales/Sales.csproj" />
    <ProjectReference Include="../../Services/Inventory/Inventory.csproj" />
    <ProjectReference Include="../../Services/HR/HR.csproj" />
    <ProjectReference Include="../../Services/Warranty/Warranty.csproj" />
    <ProjectReference Include="../../Services/Content/Content.csproj" />
    <ProjectReference Include="../../Services/Payments/Payments.csproj" />
    <ProjectReference Include="../../Services/SystemConfig/SystemConfig.csproj" />
    <ProjectReference Include="../../Services/Reporting/Reporting.csproj" />
    <!-- Cookie refresh token + CSRF filter (Identity/Services/RefreshTokenCookie.cs, RequireAjaxHeaderFilter.cs). -->
    <ProjectReference Include="../../Services/Identity/Identity.csproj" />
  </ItemGroup>
</Project>
