<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Entity Framework - 8.0.2 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.2" />

    <!-- Microsoft Extensions - All 9.0.0 for consistency -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    
    <!-- ASP.NET Core - 8.0.2 -->
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="8.0.2" />
    
    <!-- Third Party -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.10" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.0" />
    <!-- D05: 8.1.3 -> 8.5.10, pinned "< 9" (9.x is commercially licensed, see nuspec). Brings
         RabbitMQ.Client 6.8.1 -> 7.2.1 transitively - a real upgrade, smoke-tested (W1-5). -->
    <PackageReference Include="MassTransit.RabbitMQ" Version="[8.5.10,9.0.0)" />
    <!-- MassTransit.EntityFrameworkCore is DELIBERATELY NOT referenced - see phase-14 Todo #2 note
         in w1-5-report.md: from 8.5.0 onward (including the D05-pinned 8.5.10) its net8.0 group
         requires Microsoft.EntityFrameworkCore.Relational >= 9.0.1, which is binary-incompatible
         with this repo's EF Core 8.0.2 pin (Directory.Build.props) - confirmed by a reproducible
         TypeLoadException on NpgsqlHistoryRepository.get_LockReleaseBehavior at API startup.
         Referencing it breaks EVERY DbContext in the process, not just the 5 outbox ones. -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <!-- BuildingBlocks/Email: same version already used by Communication.csproj, so it is already
         restored in every dev's NuGet cache - no new dependency surface. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Scriban" Version="7.4.0" />
    <!-- D10 / BuildingBlocks.Spreadsheet: the ONE ClosedXML for the solution. Same 0.104.1 that
         Reporting.csproj and ApiGateway.csproj already reference - do not add a second version. -->
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    
    <!-- Testing -->
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vietnamese transactional-mail bodies, rendered by EmailTemplateRenderer at send time. -->
    <EmbeddedResource Include="Email\Templates\*.scriban" />
  </ItemGroup>

</Project>